# Copy this file to .env and fill in your key.
GEMINI_API_KEY=...

# Model used for Day 1 extraction (LlamaIndex) AND Day 2 Cypher/answer
# generation (LangChain) unless overridden separately below.
CHRONOGRAPH_EXTRACTION_MODEL=gemini-3.1-flash-lite

# Optional: use a different (e.g. cheaper/faster) model for Day 2 question
# answering than for Day 1 extraction. Falls back to
# CHRONOGRAPH_EXTRACTION_MODEL if unset.
CHRONOGRAPH_QA_MODEL=gemini-3.1-flash-lite

# --- Neo4j (Day 2) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Set to true to use output/graph.json directly instead of a live Neo4j
# instance. Useful if Neo4j setup becomes a blocker before the demo.
CHRONOGRAPH_MOCK_MODE=false
